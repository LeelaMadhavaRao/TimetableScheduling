    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../.experiments-build",
    "rootDir": ".."
